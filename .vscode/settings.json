{
  // Format with Prettier on save, and apply ESLint's safe fixes: the same
  // tools `npm run lint` checks with, so files pass before they are pushed.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  "prettier.requireConfig": true,

  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // dist/ is a copy of src/ made by the build: edit src/, never dist/.
  "files.exclude": {
    "test-results": true,
    "playwright-report": true
  },
  "files.readonlyInclude": {
    "dist/**": true
  },
  "search.exclude": {
    "dist": true,
    "src/data": true,
    "package-lock.json": true
  },

  "cSpell.language": "en,en-GB",
  "cSpell.words": [
    "Atkinson",
    "Bricolage",
    "factbook",
    "flagcdn",
    "Leitner",
    "restcountries",
    "scalerank",
    "SPARQL",
    "Wikidata"
  ],
  "cSpell.ignorePaths": ["src/data/**", "package-lock.json", "dist/**"]
}
