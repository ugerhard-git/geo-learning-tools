{
  // Run these from Terminal → Run Task. "start" is also what F5 runs first.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start",
      "detail": "Build the site and serve it on http://127.0.0.1:4173/",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "geo-learning-tools",
        "pattern": { "regexp": "^x^" },
        "background": {
          "activeBegins": ".",
          "activeEnds": "Serving dist/ on"
        }
      }
    },
    {
      "label": "build",
      "detail": "Copy src/ to dist/ and run the security checks",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "detail": "Prettier and ESLint, as CI runs them",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "unit tests",
      "type": "npm",
      "script": "test:unit",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "browser tests",
      "detail": "Playwright, against dist/ (build first)",
      "type": "npm",
      "script": "test",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
